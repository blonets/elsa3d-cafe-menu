# ═══════════════════════════════════════════════════════════════
# Elsa3d Cafe — QR Menu System · Environment Variables
# Set these in Dokploy (Compose service → Environment tab)
# ═══════════════════════════════════════════════════════════════

# ── Database (compose-internal, NOT exposed publicly) ──
POSTGRES_USER=menu_user
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=elsa3d_menu
DATABASE_URL=postgresql://menu_user:<strong-random-password>@db:5432/elsa3d_menu

# ── Admin credentials (single admin user) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<set-at-deploy>          # hashed at first boot, never stored raw
AUTH_SECRET=<random-64-chars>           # openssl rand -hex 32

# ── Domains (no trailing slash) ──
MENU_DOMAIN=https://menu.elsa3dcafe.com
ADMIN_DOMAIN=https://adminmenueg.elsa3dcafe.com

# ── Brand (used as initial settings row values) ──
CAFE_NAME_AR=كافيه السعد
CAFE_NAME_EN=Elsa3d Cafe
CAFE_PHONE=+201025617078
CAFE_WHATSAPP=201025617078

NODE_ENV=production
